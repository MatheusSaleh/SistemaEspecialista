package regras

import com.example.sistemaespecialista.model.Hipotese
import com.example.sistemaespecialista.model.Sintoma

rule "Verificar Bateria"
when
    $s1 : Sintoma(nome == "motor_nao_liga", valor == "sim")
then
    insert(Hipotese.de("bateria", "Possível problema na bateria", drools.getRule().getName(), $s1));
end

rule "Verificar Ignição"
when
    $s1 : Sintoma(nome == "motor_gira_mas_nao_pega", valor == "sim")
then
    insert(Hipotese.de("ignicao", "Possível problema na ignição", drools.getRule().getName(), $s1));
end

rule "Sem combustível"
when
    $s1 : Sintoma(nome == "motor_gira_mas_nao_pega", valor == "sim")
    $s2 : Sintoma(nome == "nivel_combustivel", valor == "baixo")
then
    insert(Hipotese.de("combustivel", "Nível baixo de combustível", drools.getRule().getName(), $s1, $s2));
end

rule "Revisar Suspensão"
when
    $s1 : Sintoma(nome == "ruido_suspensao", valor == "sim")
    $s2 : Sintoma(nome == "quilometragem")
    eval(Integer.parseInt($s2.getValor()) > 100000)
then
    insert(Hipotese.de("suspensao", "Possível desgaste na suspensão", drools.getRule().getName(), $s1, $s2));
end

rule "Verificar alternador"
when
    $s1 : Sintoma(nome == "motor_nao_liga", valor == "sim")
    $s2 : Sintoma(nome == "bateria_nova", valor == "sim")
then
    insert(Hipotese.de("alternador", "Possível problema no alternador", drools.getRule().getName(), $s1, $s2));
end

rule "Trocar óleo urgentemente"
when
    $s1 : Sintoma(nome == "luz_oleo", valor == "acesa")
    $s2 : Sintoma(nome == "quilometragem")
    eval(Integer.parseInt($s2.getValor()) > 10000)
then
    insert(Hipotese.de("oleo", "Alerta relacionado ao óleo", drools.getRule().getName(), $s1, $s2));
end

rule "Falha nos freios"
when
    $s1 : Sintoma(nome == "freio_mole", valor == "sim")
    $s2 : Sintoma(nome == "vazamento_fluido", valor == "sim")
then
    insert(Hipotese.de("freios", "Possível problema no sistema de freios", drools.getRule().getName(), $s1, $s2));
end

rule "Superaquecimento do motor"
when
    $s1 : Sintoma(nome == "temperatura_motor", valor == "alta")
    $s2 : Sintoma(nome == "luz_alerta", valor == "acesa")
then
    insert(Hipotese.de("temperatura", "Possível superaquecimento do motor", drools.getRule().getName(), $s1, $s2));
end

rule "Correia dentada com desgaste"
when
    $s1 : Sintoma(nome == "quilometragem")
    eval(Integer.parseInt($s1.getValor()) > 60000)
    $s2 : Sintoma(nome == "ruido_motor", valor == "estranho")
then
    insert(Hipotese.de("correia", "Possível desgaste da correia dentada", drools.getRule().getName(), $s1, $s2));
end

rule "Falha complexa na injeção eletrônica considerando clima e manutenção"
when
    $consumo : Sintoma(nome == "consumo_excessivo_combustivel", valor == "sim")
    $injecao : Sintoma(nome == "luz_injecao", valor == "acesa")
    $km : Sintoma(nome == "quilometragem")
    eval(Integer.parseInt($km.getValor()) > 80000)
    $acelerador : Sintoma(nome == "resposta_acelerador", valor == "lenta")
    $checkup : Sintoma(nome == "ultimo_checkup")
    eval(Integer.parseInt($checkup.getValor()) > 180)
    $clima : Sintoma(nome == "clima", valor in ("frio", "umido", "quente", "seco"))
    $combustivel : Sintoma(nome == "tipo_combustivel", valor in ("etanol", "gasolina"))
then
    String titulo;
    if ($clima.getValor().equals("frio") || $clima.getValor().equals("umido")) {
        if ($combustivel.getValor().equals("etanol")) {
            titulo = "Possível dificuldade de combustão a frio";
        } else {
            titulo = "Possível alteração nos sensores em ambiente frio ou úmido";
        }
    } else {
        titulo = "Possível falha na injeção eletrônica";
    }
    insert(Hipotese.de("injecao", titulo, drools.getRule().getName(),
            $consumo, $injecao, $km, $acelerador, $checkup, $clima, $combustivel));
end
