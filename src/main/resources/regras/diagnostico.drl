package regras

import com.example.sistemaespecialista.model.Hipotese
import com.example.sistemaespecialista.model.Sintoma

// @quando alimenta o catálogo e as perguntas de acompanhamento.

rule "Verificar Bateria"
    @id("bateria")
    @categoria("partida")
    @titulo("Possível problema na bateria")
    @quando("motor_nao_liga=sim")
when
    $s1 : Sintoma(nome == "motor_nao_liga", valor == "sim")
then
    String titulo = "Possível problema na bateria";
    insert(Hipotese.de("bateria", titulo, drools.getRule().getName(), $s1));
end

