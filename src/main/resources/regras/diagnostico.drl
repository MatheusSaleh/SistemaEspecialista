rule "Falha complexa na injeção eletrônica considerando clima e manutenção"
    @id("injecao")
    @categoria("injecao")
    @titulo("Possível falha na injeção eletrônica")
    @quando("consumo_excessivo_combustivel=sim;luz_injecao=acesa;quilometragem>80000;resposta_acelerador=lenta;ultimo_checkup>180;clima=frio/umido/quente/seco;tipo_combustivel=etanol/gasolina")
when
    $s1 : Sintoma(nome == "consumo_excessivo_combustivel", valor == "sim")
    $s2 : Sintoma(nome == "luz_injecao", valor == "acesa")
    $s3 : Sintoma(nome == "quilometragem")
    eval(Integer.parseInt($s3.getValor()) > 80000)
    $s4 : Sintoma(nome == "resposta_acelerador", valor == "lenta")
    $s5 : Sintoma(nome == "ultimo_checkup")
    eval(Integer.parseInt($s5.getValor()) > 180)
    $s6 : Sintoma(nome == "clima", valor in ("frio", "umido", "quente", "seco"))
    $s7 : Sintoma(nome == "tipo_combustivel", valor in ("etanol", "gasolina"))
then
    String titulo = "Possível falha na injeção eletrônica";
    if ($s6.getValor().equals("frio") || $s6.getValor().equals("umido")) {
        titulo = $s7.getValor().equals("etanol")
                ? "Possível dificuldade de combustão a frio"
                : "Possível alteração nos sensores em ambiente frio ou úmido";
    }
    insert(Hipotese.de("injecao", titulo, drools.getRule().getName(), $s1, $s2, $s3, $s4, $s5, $s6, $s7));
end

